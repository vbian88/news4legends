# ============================================================
# News 4 Legends — example configuration
# Copy this file to .env and adjust for your installation.
# NEVER commit your real .env file.
# ============================================================

# Host-facing ports
NEWS4LEGENDS_UI_PORT=8081
N8N_PORT=31002

# Timezone
TZ=Europe/London

# LLM configuration
#
# Example when using OmniRoute on a Docker network:
LLM_API_URL=http://omniroute:20128/api/v1/chat/completions
LLM_MODEL=openrouter/openai/gpt-5-nano

# n8n browser URL.
# Replace NEWS_SERVER_IP with the LAN IP/hostname of your server.
N8N_EDITOR_BASE_URL=http://NEWS_SERVER_IP:31002
WEBHOOK_URL=http://NEWS_SERVER_IP:31002/

# Host directory containing read-only maintenance/security reports for the UI.
MAINTENANCE_REPORTS_DIR=./maintenance/reports
